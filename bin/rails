#!/usr/bin/env ruby
# This command will automatically be run when you run "rails" with Rails gems
# installed from the root of your application.

ENGINE_ROOT = File.expand_path("..", __dir__)
ENGINE_PATH = File.expand_path("../lib/current_scope/engine", __dir__)
APP_PATH = File.expand_path("../test/dummy/config/application", __dir__)

# Set up gems listed in the Gemfile.
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup" if File.exist?(ENV["BUNDLE_GEMFILE"])

# Coverage must start before the `require "rails/engine/commands"` below, which
# is what ends up loading the engine and the dummy app. Starting it from
# test/test_helper.rb alone was too late: lib/current_scope was already loaded,
# and Coverage cannot instrument a file retroactively, so SimpleCov reported 0%
# for every file in lib/ while still counting its lines. Only on a test run.
#
# `t` is railties' own alias for `test` (rails/commands.rb), and it resolves
# further down the stack than this line — so match it here or `bin/rails t`
# silently reproduces the bug. test/coverage_setup.rb raises if this ordering
# is ever broken again.
#
# Anchored on a word boundary rather than a bare prefix: this matches `test`,
# `t`, and every `test:*` subcommand, without arming coverage for some future
# command that merely starts with those letters.
require_relative "../test/coverage_setup" if ARGV.first&.match?(/\A(t|test)(:|\z)/)

require "rails/all"
require "rails/engine/commands"
