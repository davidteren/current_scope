<h1>Members: <%= @role.name %></h1>
<p class="cs-lede">Who holds <strong><%= @role.name %></strong> — as their one org-wide
  role, or on a specific record. Assigning the org-wide role here replaces a
  subject's current one (each subject has exactly one org-wide role).</p>

<div class="cs-toolbar">
  <%= link_to "← All roles", roles_path %>
  <span class="cs-spacer"></span>
  <% edit_allowed = current_scope_can_manage?(:update_role, role: @role) %>
  <%= link_to_if edit_allowed, "Edit permissions", edit_role_path(@role), class: "cs-btn", id: "edit_permissions" do %>
    <span id="edit_permissions">Edit permissions</span>
  <% end %>
  <% unless edit_allowed %>
    <p id="edit_permissions_limit" class="cs-hint">Your administration permissions do not allow editing this role.</p>
  <% end %>
</div>

<h2>Add org-wide members</h2>
<% if @candidates.any? %>
  <%= form_with url: role_assignments_path, method: :post do %>
    <%= hidden_field_tag :role_id, @role.id %>
    <p>
      <%= label_tag "subject_gids", "Subjects" %>
      <select name="subject_gids[]" id="subject_gids" multiple size="8"
              aria-label="Subjects to grant this role org-wide">
        <% @candidates.each do |subject| %>
          <option value="<%= subject.to_gid %>"><%= current_scope_subject_label(subject) %></option>
        <% end %>
      </select>
    </p>
    <% if @more_candidates %>
      <p class="cs-hint">Showing the first <%= @candidates.size %> subjects who don't
        already hold this role. Use the Subjects page to reach the rest.</p>
    <% end %>
    <p><%= submit_tag "Add selected as org-wide members" %></p>
  <% end %>
<% elsif @no_subjects %>
  <p class="cs-subtle" id="org_add_empty">No subjects exist yet, so there is no one to add.</p>
<% else %>
  <p class="cs-subtle">Every subject already holds this role org-wide.</p>
<% end %>

<h2>Org-wide holders <span class="cs-subtle">(<%= @org_holders.size %>)</span></h2>
<% if @org_holders.any? %>
  <div class="cs-card cs-card--flush">
    <table class="cs-table">
      <thead><tr><th>Subject</th><th></th></tr></thead>
      <tbody>
        <% @org_holders.each do |assignment| %>
          <% who = current_scope_holder_subject_label(assignment) %>
          <%# Through the canonical guard: a non-canonical stored subject_id must
              not resolve to an unrelated live subject whose GID the Remove button
              would then post to the org-clear path (#151). Split on the resolved
              record, not to_gid: a live subject whose to_gid raises must not be
              labeled deleted. %>
          <% resolved = assignment.current_scope_resolved_record("subject") %>
          <% inert = resolved.nil? && current_scope_unresolved_subject_state(assignment) == :inert %>
          <tr id="org_holder_<%= assignment.id %>"
              class="cs-org-holder<%= ' cs-row--inert' if inert %>">
            <td><%= who %></td>
            <td>
              <% if resolved %>
                <% gid = begin
                     resolved.to_gid
                   rescue StandardError
                     nil
                   end %>
                <% if gid %>
                  <%# Removing = clearing this subject's org-wide role (blank role_id). %>
                  <% clear_allowed = current_scope_can_manage?(:revoke_role, role: @role, target: resolved) %>
                  <%= form_with url: role_assignments_path, method: :post,
                        data: { cs_confirm: "Remove #{who} from #{@role.name}?" } do %>
                    <%= hidden_field_tag :subject_gid, gid %>
                    <%= hidden_field_tag :role_id, "" %>
                    <%= submit_tag "Remove", name: nil, class: "cs-btn",
                          id: "org_clear_#{assignment.id}",
                          disabled: !clear_allowed,
                          aria: { describedby: (clear_allowed ? nil : "org_clear_#{assignment.id}_limit") } %>
                  <% end %>
                  <% unless clear_allowed %>
                    <p id="org_clear_<%= assignment.id %>_limit" class="cs-hint">Your administration permissions do not allow this removal.</p>
                  <% end %>
                <% else %>
                  <% remove_allowed = current_scope_can_manage?(:revoke_role, role: @role, target: nil) %>
                  <%= button_to "Remove", role_assignment_path(assignment), method: :delete,
                        id: "org_remove_#{assignment.id}",
                        class: "cs-btn",
                        disabled: !remove_allowed,
                        form: { data: { cs_confirm: "Remove #{who} from #{@role.name}?" } },
                        aria: { describedby: (remove_allowed ? nil : "org_remove_#{assignment.id}_limit") } %>
                  <% unless remove_allowed %>
                    <p id="org_remove_<%= assignment.id %>_limit" class="cs-hint">Your administration permissions do not allow this removal.</p>
                  <% end %>
                <% end %>
              <% elsif inert %>
                <% remove_allowed = current_scope_can_manage?(:revoke_role, role: @role, target: nil) %>
                <%= button_to "Remove inert", role_assignment_path(assignment), method: :delete,
                      id: "org_remove_#{assignment.id}",
                      class: "cs-btn",
                      disabled: !remove_allowed,
                      form: { data: { cs_confirm: "Remove this inert org-wide assignment? The subject row may still exist." } },
                      aria: { describedby: (remove_allowed ? nil : "org_remove_#{assignment.id}_limit") } %>
                <% unless remove_allowed %>
                  <p id="org_remove_<%= assignment.id %>_limit" class="cs-hint">Your administration permissions do not allow this removal.</p>
                <% end %>
                <span class="cs-inert-badge"
                      title="This subject cannot be resolved from the stored type and id. The row may still exist, but this assignment grants nothing.">inert</span>
              <% else %>
                <% remove_allowed = current_scope_can_manage?(:revoke_role, role: @role, target: nil) %>
                <%= button_to "Remove", role_assignment_path(assignment), method: :delete,
                      id: "org_remove_#{assignment.id}",
                      class: "cs-btn",
                      disabled: !remove_allowed,
                      form: { data: { cs_confirm: "Remove this orphaned org-wide assignment?" } },
                      aria: { describedby: (remove_allowed ? nil : "org_remove_#{assignment.id}_limit") } %>
                <% unless remove_allowed %>
                  <p id="org_remove_<%= assignment.id %>_limit" class="cs-hint">Your administration permissions do not allow this removal.</p>
                <% end %>
                <span class="cs-subtle">subject deleted</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="cs-subtle">No subject holds this as their org-wide role yet.</p>
<% end %>

<h2>Scoped holders <span class="cs-subtle">(<%= @scoped_holders.size %>)</span></h2>
<% if @scoped_holders.any? %>
  <div class="cs-card cs-card--flush">
    <table class="cs-table">
      <thead><tr><th>Subject</th><th>Record</th><th></th></tr></thead>
      <tbody>
        <% @scoped_holders.each do |sra| %>
          <% who = current_scope_holder_subject_label(sra) %>
          <% what = current_scope_holder_resource_label(sra) %>
          <% orphaned = sra.orphaned_resource? %>
          <tr id="scoped_holder_<%= sra.id %>"
              class="cs-scoped-holder<%= ' cs-row--inert' if orphaned %>">
            <td><%= who %></td>
            <td>
              <%= what %>
              <% if orphaned %>
                <span class="cs-inert-badge"
                      title="This resource no longer resolves; the grant opens nothing on collection reads">inert</span>
              <% end %>
              <% if (diag = current_scope_grant_diagnosis_badge(sra)) %>
                <span class="<%= diag[0] %>" title="<%= diag[2] %>"><%= diag[1] %><span class="cs-badge-note"> — <%= diag[2] %></span></span>
              <% end %>
            </td>
            <td>
              <% revoke_prompt = orphaned ?
                    "Remove inert scoped grant (resource unavailable) for #{who}?" :
                    "Revoke #{@role.name} on #{what} from #{who}?" %>
              <% recipient = sra.current_scope_resolved_record("subject") %>
              <% revoke_allowed = current_scope_can_manage?(:revoke_scoped_role, role: @role, target: recipient) %>
              <%= button_to (orphaned ? "Remove inert" : "Revoke"),
                    scoped_role_assignment_path(sra), method: :delete,
                    id: "scoped_revoke_#{sra.id}",
                    class: "cs-btn",
                    disabled: !revoke_allowed,
                    form: { data: { cs_confirm: revoke_prompt } },
                    aria: { describedby: (revoke_allowed ? nil : "scoped_revoke_#{sra.id}_limit") },
                    data: { turbo_confirm: revoke_prompt } %>
              <% unless revoke_allowed %>
                <p id="scoped_revoke_<%= sra.id %>_limit" class="cs-hint">Your administration permissions do not allow this removal.</p>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="cs-subtle">No one holds this role on a specific record.</p>
<% end %>
