<h1><%= @bulk_subjects.any? ? "Grant a scoped role to #{@bulk_subjects.size} #{'subject'.pluralize(@bulk_subjects.size)}" : "Grant a scoped role" %></h1>

<p class="cs-hint">
  A scoped role applies only when acting on the chosen record — it never
  changes the subject's org-wide role.
</p>

<%#
  Two forms, on purpose:

  * The cascade is a GET form (id "cs-cascade"). Each control re-renders the
    downstream steps: with Turbo it swaps just the #cascade frame; without JS
    or Turbo the "Show records" submit does a full-page GET (every selection is
    preserved from params). A GET form carries NO CSRF token — a token in a GET
    would leak into the URL (server logs, history, Referer).

  * The grant is a state change, so it is a SEPARATE POST form (button_to)
    rendered inside the frame once the selection is complete. button_to puts
    the CSRF token in the request body, never a URL. It lives OUTSIDE the GET
    form (nesting <form>s is invalid) and reaches the cascade's inputs via the
    HTML `form:` attribute, which also lets the GET stay idempotent so the
    picker still works while impersonating (read-only), where a POST would 403.
%>
<%= form_with url: new_scoped_role_assignment_path, method: :get, id: "cs-cascade",
      data: { turbo_frame: "cascade" }, class: "cs-picker" do %>
  <p>
    <%= label_tag :role_id, "Role" %>
    <%# include_blank, or the browser preselects the first role while the server
        has applied none — the type list would then contradict the role showing
        beside it until the first autosubmit (#183 review). %>
    <%= select_tag :role_id,
          options_from_collection_for_select(@roles, :id, :name, params[:role_id]),
          include_blank: "— choose a role —",
          data: { current_scope_autosubmit: true } %>
  </p>
  <% if @bulk_subjects.any? %>
    <p>
      <span class="cs-label" id="cs_bulk_subjects_label">Subjects</span>
      <span class="cs-hint" aria-labelledby="cs_bulk_subjects_label">
        Granting to <strong><%= @bulk_subjects.size %></strong>:
        <%= @bulk_subjects.map { |s| current_scope_subject_label(s) }.to_sentence %>
      </span>
      <% @bulk_subjects.each do |s| %>
        <%= hidden_field_tag "subject_gids[]", s.to_gid.to_s %>
      <% end %>
    </p>
  <% else %>
    <p>
      <%= label_tag :subject_gid, "Subject" %>
      <%= select_tag :subject_gid,
            options_for_select(@subjects.map { |s| [ current_scope_subject_label(s), s.to_gid.to_s ] },
                               params[:subject_gid]),
            data: { current_scope_autosubmit: true } %>
    </p>
  <% end %>
<% end %>

<turbo-frame id="cascade">
  <%# Every sentence below that names the role runs only when a role IS chosen —
      each flag the controller sets is computed from one. Reading the name once,
      nil-safe, keeps that coupling in view instead of in six dereferences
      (#183 review). %>
  <% role_name = @selected_role&.name %>
  <% if @missing_role %>
    <p id="cs_role_missing" class="cs-alert cs-picker-empty">
      That role is no longer available. Pick one from the list to go on.
    </p>
  <% end %>

  <%# A refused deep link is explained wherever it happens, INCLUDING the states
      below that render nothing else — the refusal is often why the picker has
      no type on screen at all (#183 review). %>
  <% if @refused_resource && role_name %>
    <p id="cs_resource_refused" class="cs-hint cs-picker-empty cs-resource-refused">
      The linked <strong><%= current_scope_label(@refused_resource) %></strong>
      is not in the list: <strong><%= role_name %></strong> may not be
      granted on it. Pick a different role, or a different record.
    </p>
  <% end %>

  <%# Anchors an unregistered deep-linked type across a change of record: the
      type cannot be resolved from its name, only from a record. Outside the
      case for the same reason the submit is: the states that render nothing
      else are the ones an operator most needs to get back out of (#183 review). %>
  <% if @type_anchor_gid %>
    <%= hidden_field_tag :linked_gid, @type_anchor_gid, form: "cs-cascade" %>
  <% end %>

  <%# Two different empties (#183 review): nothing registered at all, and
      everything registered withheld because it does not accept the chosen role.
      Both give way to a deep link that DID resolve a type: a type reached by
      link need not be registered, and throwing away a grantable target to say
      "no type accepts this role" would be both a dead end and untrue. %>
  <% case @types.state
     when :none_accept %>
    <p id="cs_types_none_accept" class="cs-alert cs-picker-empty cs-types-none-accept">
      No resource type accepts <strong><%= role_name %></strong>.
      Each registered type declares which roles may be granted on it, and none
      lists this one. Pick a different role.
    </p>
  <% when :unregistered %>
    <p id="cs_types_unregistered" class="cs-alert cs-picker-empty cs-types-unregistered">
      No pickable resource types yet. Add
      <code>include CurrentScope::Scopeable</code> to a host model to make its
      records selectable here.
    </p>
  <% else %>
    <% if @types.withheld? %>
      <p id="cs_types_withheld" class="cs-hint cs-types-withheld">
        <%= pluralize(@types.withheld_count, "type") %> not listed. Each declares
        which roles may be granted on it, and <strong><%= role_name %></strong>
        is not one. Pick a different role to see
        <%= @types.withheld_count == 1 ? "it" : "them" %>.
      </p>
    <% end %>
    <p>
      <%= label_tag :resource_type, "Resource type" %>
      <%= select_tag :resource_type,
            options_for_select(@types.options, @resource_type&.name),
            include_blank: "— choose a type —", form: "cs-cascade",
            data: { current_scope_autosubmit: true } %>
    </p>

    <% if @resource_type %>
      <%# The search box stays on an empty list only where searching reads past
          the scanned window: with an indexed scope a grantable record can sit
          past it, while the fallback scan would re-read the very rows the empty
          list came from (#183 review). %>
      <% if @step.offer_search? %>
        <p>
          <%= label_tag :q, "Search records" %>
          <%= search_field_tag :q, params[:q], placeholder: "Filter by label",
                form: "cs-cascade", data: { current_scope_autosubmit: true } %>
        </p>
      <% end %>
      <%# @resource excluded: a surviving deep-linked record is prepended to the
          options in the else branch, and skipping to the empty state would leave
          a Grant button posting a record the page never shows (#183 review). %>
      <% if @step.empty? %>
        <%# The controller NAMES this state; the class a test selects and the
            sentence an operator reads come from the same answer, so a copy edit
            cannot leave the suite green with the wrong text (#183 review).
            "looked at", never "none": the role filter runs over the scanned
            rows, so a grantable record can sit past the window. %>
        <p id="cs_records_<%= @step.records_state %>" class="cs-hint cs-picker-empty cs-records-<%= @step.records_state.to_s.dasherize %>">
          <% case @step.records_state
             when :refused_searchable %>
            None of the <%= @resource_type.model_name.human.pluralize.downcase %>
            looked at accept <strong><%= role_name %></strong>. Search
            for one, or pick a different role.
          <% when :refused %>
            None of the <%= @resource_type.model_name.human.pluralize.downcase %>
            looked at accept <strong><%= role_name %></strong>. Pick a different
            role.
          <% else %>
            No <%= @resource_type.model_name.human.pluralize.downcase %> to pick from yet.
          <% end %>
        </p>
      <% else %>
        <p>
          <%= label_tag :resource_gid, "Record" %>
          <%# The step owns the LIST, and the Grant button is checked against
              the same one, so it cannot post a record this select never showed
              (#183 review). %>
          <% record_options = @step.offered_records.map { |record| [ current_scope_label(record), record.to_gid.to_s ] } %>
          <%= select_tag :resource_gid,
                options_for_select(record_options, params[:resource_gid] || @resource&.to_gid&.to_s),
                include_blank: "— choose a record —", form: "cs-cascade",
                data: { current_scope_autosubmit: true } %>
          <% if @step.search_state %>
            <%# Keyed off the raw SEARCH results, not record_options — a
                deep-linked @resource is prepended to the options even when the
                query matched nothing, and must not fake a "matches shown". %>
            <% if @step.matches_shown? %>
              <span id="cs_search_<%= @step.search_state %>" class="cs-hint cs-search-shown">
                Showing up to <%= CurrentScope::ScopedRoleAssignmentsController::DISPLAY_LIMIT %> matches — refine the search to narrow.
                <% if @step.search_state == :shown_withheld && role_name %>
                  <%# No other hint on the page covers RECORDS the role filter
                      took out of a list that still has matches (#183 review). %>
                  Matches that do not accept <strong><%= role_name %></strong> are
                  not listed.
                <% end %>
              </span>
            <% else %>
              <span id="cs_search_<%= @step.search_state %>" class="cs-hint cs-picker-empty cs-search-<%= @step.search_state.to_s.dasherize %>">
                <% case @step.search_state
                   when :refused_searchable %>
                  <%# The matches READ all refuse, but the search stopped at its
                      cap, so a narrower search can still turn one up. %>
                  No match for “<%= params[:q] %>” read so far accepts
                  <strong><%= role_name %></strong> — narrow the search, or pick
                  a different role.
                <% when :refused %>
                  <%# The search DID match — a different search is the one thing
                      that cannot help. "read", because the fallback scan stops
                      at its cap and cannot speak for the whole table. %>
                  No match for “<%= params[:q] %>” among the records read accepts
                  <strong><%= role_name %></strong> — pick a different role.
                <% else %>
                  No records match “<%= params[:q] %>” — try a different search.
                <% end %>
              </span>
            <% end %>
          <% end %>
        </p>
      <% end %>
    <% end %>

  <% end %>
  <%# Outside the branches on purpose: without JavaScript this submit is the
      only way to re-run the cascade, and the state where every type withheld
      the role is recoverable by changing the role — but only if the operator
      can still submit (#183 review). %>
  <p class="cs-picker-actions">
    <%# No-JS / no-Turbo fallback: reload the cascade with the current picks. %>
    <%= submit_tag "Show records", name: nil, form: "cs-cascade", class: "cs-picker-refresh" %>
    <%# Grant only a selection that is actually on offer. Every cascade control
        autosubmits, but a resource_gid picked earlier survives a change of role
        or type, so the controller hands us the gid the operator can SEE
        selected (nil when the stale one is no longer listed). %>
    <%# The RESOLVED role, not the param: a deleted id would otherwise post a
        Grant that can only fail (#183 review). %>
    <% ready = @selected_role.present? && @grantable_gid.present? %>
    <% if @bulk_subjects.any? %>
      <% if ready %>
        <%= button_to "Grant to #{@bulk_subjects.size} #{'subject'.pluralize(@bulk_subjects.size)}",
              scoped_role_assignments_path, method: :post,
              params: { role_id: @selected_role.id, resource_gid: @grantable_gid,
                        subject_gids: @bulk_subjects.map { |s| s.to_gid.to_s } },
              data: { turbo_frame: "_top" }, class: "cs-btn-primary" %>
      <% end %>
    <% elsif ready && params[:subject_gid].present? %>
      <%= button_to "Grant scoped role", scoped_role_assignments_path, method: :post,
            params: { role_id: @selected_role.id, subject_gid: params[:subject_gid],
                      resource_gid: @grantable_gid },
            data: { turbo_frame: "_top" }, class: "cs-btn-primary" %>
    <% end %>
  </p>
</turbo-frame>
